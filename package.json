{
	"name": "intranet-next-app",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "next build",
		"db:test:reset": "bash scripts/setup-test-db.sh --reseed",
		"db:test:setup": "bash scripts/setup-test-db.sh",
		"dev": "next dev",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"deploy:preprod": "opennextjs-cloudflare build --env preprod && opennextjs-cloudflare deploy --env preprod",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"fixtures:check": "ts-node -P tsconfig.scripts.json tests/fixtures/generate.ts --check",
		"fixtures:generate": "ts-node -P tsconfig.scripts.json tests/fixtures/generate.ts",
		"format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"lint": "next lint",
		"run-script": "ts-node -P tsconfig.scripts.json scripts/index.ts",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.mts",
		"test:integration:watch": "vitest --config vitest.integration.config.mts",
		"test:watch": "vitest",
		"e2e": "playwright test --config e2e/playwright.config.ts --project chromium",
		"e2e:headed": "playwright test --config e2e/playwright.config.ts --project headed --workers 1",
		"e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
		"e2e:test": "tsx e2e/cli.ts test",
		"e2e:login": "tsx e2e/cli.ts login",
		"e2e:personas": "tsx e2e/cli.ts personas"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.19.11",
		"@radix-ui/react-accordion": "^1.2.12",
		"@radix-ui/react-avatar": "^1.1.10",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-navigation-menu": "^1.2.14",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@supabase/ssr": "^0.10.2",
		"@supabase/supabase-js": "^2.103.0",
		"@tanstack/react-table": "^8.21.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"csv-parse": "^5.6.0",
		"lucide-react": "^0.545.0",
		"next": "^15.1.2",
		"next-themes": "^0.4.6",
		"react": "^18",
		"react-dom": "^18",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@tailwindcss/postcss": "^4.1.14",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^22.16.2",
		"@types/pg": "^8.20.0",
		"@types/react": "^18",
		"@types/react-dom": "^18",
		"@types/uuid": "^10.0.0",
		"@vitejs/plugin-react": "^5.2.0",
		"dotenv": "^17.4.2",
		"eslint": "^8",
		"eslint-config-next": "14.2.13",
		"happy-dom": "^20.9.0",
		"pg": "^8.21.0",
		"postcss": "^8",
		"prettier": "^3.8.2",
		"tailwindcss": "^4.1.14",
		"ts-node": "^10.9.2",
		"tsx": "^4.22.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.7.2",
		"uuid": "^14.0.0",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.1.4",
		"wrangler": "^4.95.0"
	}
}
