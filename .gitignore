# Local .terraform directories
**/.terraform/*

# AWS credentials file (if any)
.aws
*/.aws

# Stage configuration file
*.env.json
!demo.*.*.json

# .tfstate and lock files
*.tfstate
*.tfstate.*
*.terraform.lock.hcl

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# logs
*.log
/log/

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# open-next
.open-next

# cloudflare
.dev.vars
cloudflare-env.d.ts
.wrangler/

# playwright MCP artifacts (browser console logs from MCP tool runs)
.playwright-mcp/
.playwright-cli/

# Supabase local working artifacts (config.toml IS committed; these are not)
supabase/.branches/
supabase/.temp/

# Test DB bootstrap output
.supabase-test-db.log

# Liquibase per-run output
liquibase.properties

# Local-only Supabase env for integration tests (regenerated from `supabase status`).
.env.test

# Playwright
test-results/
playwright-report/
blob-report/
e2e/.session-cache.json

# Claude Code harness artifacts
.claude/scheduled_tasks.lock
.superpowers/
