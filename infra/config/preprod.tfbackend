# R2 (S3-compatible) state for preprod. Key convention: <env>/<project-code>/terraform.tfstate
# Account-specific endpoint + credentials come from env vars, never committed:
#   AWS_ENDPOINT_URL_S3, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# Init with: terraform init -backend-config=config/preprod.tfbackend
bucket                      = "com-infra-tfstate-cloudflare"
key                         = "preprod/intranet-web/terraform.tfstate"
region                      = "auto"
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
use_path_style              = true
